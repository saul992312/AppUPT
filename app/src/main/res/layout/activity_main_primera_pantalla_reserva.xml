<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_main">

    <LinearLayout
        android:orientation="vertical"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- HEADER LOGOS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:scaleType="fitStart"
                android:src="@drawable/logo"
                android:contentDescription="Logo Izquierdo"/>

            <ImageView
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:scaleType="fitEnd"
                android:src="@drawable/logo_upt"
                android:contentDescription="Logo UPT"/>

        </LinearLayout>

        <!-- TITULO -->
        <TextView
            android:text="BIENVENIDO"
            android:textSize="34sp"
            android:fontFamily="@font/goldman"
            android:textColor="#D4AF37"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- DESCRIPCION -->
        <TextView
            android:text="Para poder reservar el gimnasio debes subir los siguientes documentos."
            android:textSize="16sp"
            android:fontFamily="@font/inter_regular"
            android:textColor="#000000"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- SUBTITULO -->
        <TextView
            android:text="LA SIGUIENTE DOCUMENTACIÓN SE SUBE EN UN SOLO PDF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/goldman"
            android:textColor="#590000"
            android:gravity="center"
            android:layout_marginBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- LISTA DOCUMENTOS -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:text="• Vigencia de derechos"
                android:textSize="16sp"
                android:fontFamily="@font/inter_regular"
                android:textColor="#000000"
                android:layout_marginBottom="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="• Certificado médico"
                android:textSize="16sp"
                android:fontFamily="@font/inter_regular"
                android:textColor="#000000"
                android:layout_marginBottom="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="• Credencial de estudiante"
                android:textSize="16sp"
                android:fontFamily="@font/inter_regular"
                android:textColor="#000000"
                android:layout_marginBottom="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="• Carta responsiva"
                android:textSize="16sp"
                android:fontFamily="@font/inter_regular"
                android:textColor="#000000"
                android:layout_marginBottom="24dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </LinearLayout>

        <!-- BOTON -->
        <Button
            android:id="@+id/btnCrearReserva"
            android:text="Guardar"
            android:textSize="18sp"
            android:fontFamily="@font/inter_regular"
            android:textColor="#FFFFFF"
            android:layout_marginTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/boton_redondeado"/>

        <!-- TERMINOS -->
        <CheckBox
            android:id="@+id/checkTerminos"
            android:text="Acepto los términos y condiciones"
            android:textSize="14sp"
            android:fontFamily="@font/inter_regular"
            android:textColor="#FFFFFF"
            android:layout_marginTop="20dp"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <RadioGroup
            android:id="@+id/rgTipoUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="30dp"
            android:background="@android:color/white"
            android:padding="12dp">

            <RadioButton
                android:id="@+id/rbAdmin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ADMINISTRADOR"
                android:textStyle="bold"
                android:textColor="#7A0C0C"
                android:layout_marginEnd="40dp"/>

            <RadioButton
                android:id="@+id/rbUsuario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USUARIO"
                android:textStyle="bold"
                android:textColor="#7A0C0C"/>

        </RadioGroup>

    </LinearLayout>

</ScrollView>
