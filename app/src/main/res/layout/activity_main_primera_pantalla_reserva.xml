<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_main">

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:fontFamily="@font/goldman"
        android:text="BIENVENIDO"
        android:textColor="#D4AF37"
        android:textSize="32sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="44dp"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/inter_regular"
        android:text="@string/documentos"
        android:textColor="#000"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="76dp"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/inter_regular"
        android:text="@string/siguiente_documentacion"
        android:textColor="#000"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView2" />

    <Button
        android:id="@+id/vigencia"
        android:layout_width="268dp"
        android:layout_height="39dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="#E89A9A"
        android:fontFamily="@font/inter_regular"
        android:text="VIGENCIA DE DERECHOS"
        android:textColor="#000"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView3" />

    <Button
        android:id="@+id/certificado"
        android:layout_width="268dp"
        android:layout_height="39dp"
        android:layout_marginTop="26dp"
        android:backgroundTint="#E89A9A"
        android:fontFamily="@font/inter_regular"
        android:text="CERTIFICADO MÉDICO"
        android:textColor="#000"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vigencia" />

    <Button
        android:id="@+id/credencial"
        android:layout_width="268dp"
        android:layout_height="39dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="#E89A9A"
        android:fontFamily="@font/inter_regular"
        android:text="CREDENCIAL DE ESTUDIANTE"
        android:textColor="#000"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.503"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/certificado" />

    <Button
        android:id="@+id/carta"
        android:layout_width="268dp"
        android:layout_height="39dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="#E89A9A"
        android:fontFamily="@font/inter_regular"
        android:text="CARTA RESPONSIVA"
        android:textColor="#000"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/credencial" />

    <Button
        android:id="@+id/guardar"
        android:layout_width="268dp"
        android:layout_height="39dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="#E89A9A"
        android:fontFamily="@font/inter_regular"
        android:text="GUARDAR"
        android:textColor="#000"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/carta"
        app:layout_constraintVertical_bias="0.076" />

</androidx.constraintlayout.widget.ConstraintLayout>