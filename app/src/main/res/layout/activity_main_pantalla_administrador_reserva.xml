<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_main">

    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- LOGOS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                android:src="@drawable/logo"/>

            <ImageView
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                android:scaleType="fitEnd"
                android:src="@drawable/logo_upt"/>
        </LinearLayout>

        <!-- TITULO -->
        <TextView
            android:text="ADMINISTRADOR UPT"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#D4AF37"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- NOMBRE -->
        <EditText
            android:id="@+id/txtAdminNombre"
            android:hint="Nombre de Administrador"
            android:layout_marginTop="20dp"
            android:background="#EEEEEE"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- ID -->
        <EditText
            android:id="@+id/txtAdminID"
            android:hint="ID de Admin"
            android:background="#EEEEEE"
            android:padding="12dp"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- CARD RESERVACIONES -->
        <androidx.cardview.widget.CardView
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="RESERVACIONES ACTUALES"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#7A0C0C"
                    android:layout_marginBottom="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="Juan Pérez  |  202401  |  Mar 12  |  9 AM  | Confirmada"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="María López | 202402 | Mar 12 | 12 PM | Confirmada"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="Carlos Díaz | 202403 | Mar 13 | 10 AM | Pendiente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- ACCIONES -->
        <TextView
            android:text="ACCIONES RÁPIDAS"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#D4AF37"
            android:gravity="center"
            android:layout_marginTop="30dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btnUsuarios"
            android:text="Ver todos los usuarios"
            android:backgroundTint="#7A0C0C"
            android:textColor="#FFFFFF"
            android:layout_marginTop="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btnHistorial"
            android:text="Historial completo"
            android:backgroundTint="#7A0C0C"
            android:textColor="#FFFFFF"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btnHorarios"
            android:text="Configuración de horarios"
            android:backgroundTint="#7A0C0C"
            android:textColor="#FFFFFF"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btnConfirmar"
            android:text="CONFIRMAR RESUMEN"
            android:textSize="18sp"
            android:backgroundTint="#7A0C0C"
            android:textColor="#FFFFFF"
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>

</ScrollView>